modules = ["nodejs-20"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["gh", "tambura", "nano", "lsof", "psmisc"]

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5050
externalPort = 3000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
publicDir = ".next/standalone"
run = ["npm", "run", "start"]

[userenv]

[userenv.shared]

[userenv.development]
FRACTPATH_APP_URL = "https://e65d6c0f-2424-4792-91b7-dbc5497fad14-00-3p7hkgjzlnfo9.spock.replit.dev"
NEXT_PUBLIC_FRACTPATH_APP_URL = "https://e65d6c0f-2424-4792-91b7-dbc5497fad14-00-3p7hkgjzlnfo9.spock.replit.dev"

[userenv.production]
FRACTPATH_APP_URL = "https://app.fractpath.com"
NEXT_PUBLIC_FRACTPATH_APP_URL = "https://app.fractpath.com"
